\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Population search improves K2000 cut quality, with diminishing best-cut returns.} QeFEM's mean, range, and best final cut across five paired seeds are shown at each nested population size. The saved LQA{} mean (one state per trial) and the 33,337 stored target are horizontal references. The best QeFEM{} cut rises from 33,255 at 128 replicas to 33,293 by 2,048, then remains there through 8,192. No point in this figure implies a matched-compute comparison.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:k2000-population}{{2}{11}{\textbf {Population search improves K2000 cut quality, with diminishing best-cut returns.} QeFEM's mean, range, and best final cut across five paired seeds are shown at each nested population size. The saved \LQA {} mean (one state per trial) and the 33,337 stored target are horizontal references. The best \QeFEM {} cut rises from 33,255 at 128 replicas to 33,293 by 2,048, then remains there through 8,192. No point in this figure implies a matched-compute comparison}{figure.2}{}}
